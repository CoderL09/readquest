<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.readquest.mapper.UserMapper"><select id="findById" resultType="com.readquest.pojo.User">SELECT * FROM users WHERE id=#{id}</select>
<select id="findByEmail" resultType="com.readquest.pojo.User">SELECT * FROM users WHERE email=#{email}</select>
<insert id="insert">INSERT INTO users(id,email,display_name,avatar_url,password_hash,role,status,created_at,updated_at) VALUES(#{id},#{email},#{displayName},'',#{passwordHash},'user','active',#{createdAt},#{updatedAt})</insert>
<update id="updateAvatar">UPDATE users SET avatar_url=#{url},updated_at=CURRENT_TIMESTAMP(3) WHERE id=#{user} AND status='active'</update>
</mapper>
