{
  "name": "readquest-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint src --deny-warnings",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node scripts/test-unit.mjs",
    "test:components": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "format": "prettier --write src tests scripts *.ts *.json index.html",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html"
  },
  "dependencies": {
    "@lucide/vue": "^1.65.0",
    "axios": "^1.18.1",
    "dompurify": "^3.3.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.1.3",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
